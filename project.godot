; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BUFFER ZONE"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/images/icon/icon.png"
config/windows_native_icon="res://assets/images/icon/icon.ico"

[autoload]

Loc="*res://scripts/autoload/loc.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
GameData="*res://scripts/autoload/game_data.gd"
World="*res://scripts/autoload/world.gd"
Feed="*res://scripts/autoload/feed.gd"
PlayerData="*res://scripts/autoload/player_data.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Monitor="*res://scripts/autoload/monitor.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/VT323-Regular.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
